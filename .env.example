# Copy to .env and fill in. Never prefix a secret with NEXT_PUBLIC_:
# anything NEXT_PUBLIC_* is bundled into the JavaScript sent to browsers.

# --- Server only ---
# Base URL of sis-backend as reachable from the Next.js server
BACKEND_URL=http://localhost:3000

# --- Public (safe to expose to browsers) ---
# Root domain; the portals are served on app.<domain> and admin.<domain>
NEXT_PUBLIC_DOMAIN_NAME=localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=
NEXT_PUBLIC_LINKEDIN_REDIRECT_URI=http://app.localhost:4000/auth/linkedin

# Bank transfer details shown on the student payments page.
# The bank-transfer section is hidden unless all three are set.
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
# Optional: shown on the payments page ("email your receipt to ...")
NEXT_PUBLIC_SUPPORT_EMAIL=
